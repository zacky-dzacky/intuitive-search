# Copy to .env.local for local dev (in k8s these are set via admin-dashboard/k8s/secret.yaml).

# Postgres holding the `features` registry. Same database the backend reads.
DATABASE_URL=postgresql://bank:bank@localhost:5432/banksearch

# The Spring backend — used by the Search Playground and the Search index page.
BACKEND_BASE_URL=http://localhost:8080

# Single-admin login. CHANGE BOTH before exposing this anywhere.
ADMIN_PASSWORD=change-me
# Signs the session cookie. Any long random string: `openssl rand -hex 32`.
SESSION_SECRET=dev-only-secret-change-me-to-32-plus-random-bytes

# Session lifetime in hours.
SESSION_TTL_HOURS=12
